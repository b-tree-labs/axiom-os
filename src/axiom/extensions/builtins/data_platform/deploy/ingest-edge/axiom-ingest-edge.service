#
# An ingest edge (ADR-177): the public node producers push to and the owning
# node pulls from. Serves /ingest, /edge and /healthz and nothing else, on
# loopback; the TLS proxy (Caddyfile beside this) is the only thing on 443.
[Unit]
Description=Axiom ingest edge (bronze landing; downstream pulls)
After=network-online.target
Wants=network-online.target

[Service]
User=axiom-edge
Group=axiom-edge
EnvironmentFile=/etc/axiom-edge/edge.env
# Refuse to start short of disk; AXIOM_EDGE_MIN_FREE_GIB is set in edge.env.
ExecStartPre=/opt/axiom-edge/check-free-space.sh /var/lib/axiom-edge ${AXIOM_EDGE_MIN_FREE_GIB}
ExecStart=/opt/axiom-edge/venv/bin/axi serve --profile ingest-edge --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
# The edge writes only its state and bronze trees.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/axiom-edge

[Install]
WantedBy=multi-user.target
