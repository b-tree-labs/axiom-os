# /etc/axiom-edge/edge.env, mode 0640, owned root:axiom-edge.
# No secret belongs in this file. Keys are stored as hashes in the keys file;
# the plaintext of each exists once, when it is issued.
# AXIOM_MODE is left unset. The production governance engine graduates new
# action classes through approvals kept in Postgres, and an edge has no
# database. Its gates are deterministic instead: issued keys with scopes,
# credential-derived site, the downstream allow-list below, and no anonymous
# access even though it binds loopback behind the proxy (ADR-177).
AXI_STATE_DIR=/var/lib/axiom-edge/state
# Where the outbox lives. Setting it is what makes this node an edge.
AXIOM_INGEST_OUTBOX_DIR=/var/lib/axiom-edge/outbox
# The downstream nodes allowed to pull, by principal. Unset exports to nobody.
AXIOM_EDGE_DOWNSTREAM=@downstream-node:org
# The edge will not start with less free space than this under /var/lib/axiom-edge.
AXIOM_EDGE_MIN_FREE_GIB=50
# Issued keys, hashed (axi gate issue api-key writes here).
AXIOM_GATE_API_KEYS_FILE=/var/lib/axiom-edge/state/gate-api-keys.json
# Per-site admission (ADR-157 budgets at the face): burst, then sustained rate.
AXIOM_INGEST_BURST=120
AXIOM_INGEST_RATE_PER_SECOND=20
AXIOM_INGEST_MAX_BATCHES=500
AXIOM_INGEST_MAX_ROWS_PER_BATCH=50000
