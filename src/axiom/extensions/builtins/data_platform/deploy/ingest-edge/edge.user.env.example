# ~/.config/axiom-edge/edge.env for the per-user edge, mode 0600.
# Paths are absolute: an env file does not expand ~ or %h.
# No secret belongs in this file; keys are stored hashed in the keys file.
AXIOM_EDGE_PORT=8787
# All of the edge's data lives under this directory: on the volume with room,
# either under the operator's home or a directory an administrator created.
AXIOM_EDGE_DATA_DIR=/home/OPERATOR/axiom-edge-data
AXIOM_EDGE_MIN_FREE_GIB=20
AXI_STATE_DIR=/home/OPERATOR/axiom-edge-data/state
AXIOM_INGEST_OUTBOX_DIR=/home/OPERATOR/axiom-edge-data/outbox
AXIOM_GATE_API_KEYS_FILE=/home/OPERATOR/axiom-edge-data/state/gate-api-keys.json
# The downstream nodes allowed to pull, by principal. Unset exports to nobody.
AXIOM_EDGE_DOWNSTREAM=@downstream-node:org
AXIOM_INGEST_BURST=120
AXIOM_INGEST_RATE_PER_SECOND=20
AXIOM_INGEST_MAX_BATCHES=500
AXIOM_INGEST_MAX_ROWS_PER_BATCH=50000
